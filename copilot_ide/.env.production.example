# ==============================================================================
# Archon Copilot IDE - Production Environment Variables
# Copy this file to .env in copilot_ide/ before running docker compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Providers (Cloud fallback / Primary models)
# ------------------------------------------------------------------------------
# Groq API key for high-speed inference (Llama, GPT-OSS, etc.)
GROQ_API_KEY=
GROQ_API_KEY_2=

# OmniKey AI Gateway (optional, if using OmniKey proxy for Gemini/Claude)
OMNIKEY_API_KEY=
OMNIKEY_BASE_URL=https://omnikey-ai-unified-key-manager.onrender.com/v1beta
OMNIKEY_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Local Ollama Settings (Optional - leave default if not running Ollama on VM)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434
DEFAULT_MODEL=gemma3:4b
OLLAMA_MODEL=gemma3:4b

# ------------------------------------------------------------------------------
# 3. Host System Configuration
# ------------------------------------------------------------------------------
# Directory on host mapped into workspace. On Linux cloud VM, /tmp or your home dir.
HOST_USERS_DIR=/tmp

# ------------------------------------------------------------------------------
# 4. Optional Custom Domain & SSL (Only if using Caddy reverse proxy)
# ------------------------------------------------------------------------------
# Set this to your domain (e.g. DOMAIN_NAME=archon.yourdomain.com) for auto-HTTPS.
# Leave blank or set to :80 if accessing directly via VM Public IP.
DOMAIN_NAME=:80
SSL_EMAIL=
