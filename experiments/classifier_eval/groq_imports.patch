+
+    module_imports (module -> modules it imports, as from extract_project_dependencies) is
+    shown to the LLM as evidence when given; without it only module names are sent.
     """
     with open(ruleset_path, "r", encoding="utf-8") as f:
         ruleset = json.load(f)
