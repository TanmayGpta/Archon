# Copy the keys you need into Archon/.env (the only env file AGAI reads).
# LLMs go through FreeLLMAPI (local OpenAI-compatible router, desktop app on :31415).
FREELLMAPI_KEY=

# Optional: Langfuse tracing (https://cloud.langfuse.com, free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional overrides
# AGAI_LLM_BASE_URL=http://127.0.0.1:31415/v1
# AGAI_ADK_MODEL=auto          # or a pinned id from GET /v1/models, e.g. gemini-flash
# AGAI_CREW_MODEL=auto
# AGAI_PRICE_INPUT_PER_M=0     # free tier; set paid-equivalent prices to compare cost
# AGAI_PRICE_OUTPUT_PER_M=0
# AGAI_ALLOWED_ROOTS=C:\path\to\test_codebases
# AGAI_HEALING_A2A_URL=http://127.0.0.1:8101
